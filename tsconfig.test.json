{
  // Typecheck-only config covering the test suite. The build config (tsconfig.json) stays
  // src-only so dist output is unchanged; this one adds test/ and the bun test globals.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
